PORT=3040
# When set, dashboard + all /api/* routes (except GET /api/ping) require header x-api-key matching this value.
# API_KEY=

SETTINGS='[{"jobs":"simple-job-from-env","cron":"*/10 * * * * *","method":"GET","url":"http://localhost:3000/api/v1/simple-job","body":{"name":"John Doe"},"headers":{"x-api-key":"1234567890"}}]'
DEBUG=true
# In-memory log purge schedule (node-cron): omit for default weekly Sun 03:00; true/false; or a cron expression string.
# LOG_PURGE_CRON=true
# LOG_PURGE_CRON="0 3 * * 0"
